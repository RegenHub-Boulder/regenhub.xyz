# RegenHub Environment Variables
# Copy to .env.local for local development.
# Build-time vars (NEXT_PUBLIC_*) are in apps/web/.env.production (committed).

# ── Home Assistant (runtime, web + bot) ──────────────────────
HA_URL=http://homeassistant.local:8123/api
HA_TOKEN=
HA_LOCK_ENTITIES=lock.front_door_lock,lock.back_door_lock

# ── Supabase (runtime, bot only — web uses NEXT_PUBLIC_* from .env.production) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram Bot (runtime, bot only) ─────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Cron + newsletter secrets (runtime, web only) ────────────
# CRON_SECRET: bearer token required by /api/cron/*.
# NEWSLETTER_UNSUBSCRIBE_SECRET: signs newsletter unsubscribe links. Set it to
# its own value; falls back to CRON_SECRET if unset (so already-mailed links
# keep working), and refuses to sign with a default secret in production.
CRON_SECRET=
NEWSLETTER_UNSUBSCRIBE_SECRET=

# ── Stripe (runtime, web only) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OP_RPC_URL=
# Dedicated low-balance hot wallet used only to sponsor OP gas for EIP-3009 USDC transfers.
OP_RELAYER_PRIVATE_KEY=
NEXT_PUBLIC_STRIPE_DAYPASS_LINK=
NEXT_PUBLIC_STRIPE_FIVEPACK_LINK=
